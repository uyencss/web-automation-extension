{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webmcp.dev/schemas/webmcp-profile-action-fence.schema.json",
  "title": "WebMCP Profile Action Fence — webmcp-profile-action-fence/1",
  "description": "Per-action fence proof v1 (A1 fixture-only). Validated out-of-band before gateway/browser dispatch. D1 fenceDigest with domain label webmcp-digest-v1:fence and LF framing. Fence secret/capability never in this proof; only digests.",
  "type": "object",
  "required": [
    "schema",
    "fenceId",
    "leaseId",
    "fenceEpoch",
    "leaseBindingDigest",
    "runId",
    "bindingId",
    "purpose",
    "scope",
    "fenceDigest",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schema": {
      "const": "webmcp-profile-action-fence/1"
    },
    "fenceId": {
      "type": "string",
      "pattern": "^fence_[0-9a-f]{16}$"
    },
    "leaseId": {
      "type": "string",
      "pattern": "^lease_[0-9a-f]{16}$"
    },
    "fenceEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "leaseBindingDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[a-z0-9-]{8,}$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^pb_[a-z0-9-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    },
    "scope": {
      "type": "object",
      "required": [
        "profileAlias",
        "actions"
      ],
      "properties": {
        "profileAlias": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "browser-read",
              "browser-write",
              "browser-session-data",
              "credential-fill"
            ]
          },
          "minItems": 1
        },
        "tabHandle": {
          "type": "string",
          "pattern": "^tab_[a-z0-9-]{4,}$"
        },
        "originAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "maxItems": 16
        }
      },
      "additionalProperties": false
    },
    "fenceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Fence digest with domain label webmcp-digest-v1:fence and LF framing."
    },
    "ttlMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    },
    "maxUses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "approvalDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "actionKind": {
      "type": "string",
      "enum": [
        "click",
        "type",
        "scroll",
        "waitForStable",
        "batch",
        "read",
        "queryIndexedDB"
      ]
    }
  },
  "additionalProperties": false
}
