{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webmcp.dev/schemas/webmcp-profile-recovery-receipt.schema.json",
  "title": "WebMCP Profile Recovery Receipt — webmcp-profile-recovery-receipt/1",
  "description": "Evidence-backed recovery/reclaim receipt (A1 fixture-only). Redacted per D5 retention; D6 quarantine/reconcile authority is Governor. No raw path/value.",
  "type": "object",
  "required": [
    "schema",
    "receiptId",
    "leaseId",
    "profileAlias",
    "priorState",
    "newState",
    "priorFenceEpoch",
    "newFenceEpoch",
    "reasonCode",
    "createdAt",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "webmcp-profile-recovery-receipt/1"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^prr_[0-9a-f]{16}$"
    },
    "leaseId": {
      "type": "string",
      "pattern": "^lease_[0-9a-f]{16}$"
    },
    "profileAlias": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^pb_[a-z0-9-]+$"
    },
    "bindingRevision": {
      "type": "integer",
      "minimum": 1
    },
    "bindingDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[a-z0-9-]{8,}$"
    },
    "priorState": {
      "type": "string",
      "enum": [
        "unknown",
        "leased",
        "active",
        "cooldown",
        "external_use",
        "auth_required",
        "challenge",
        "rate_limited",
        "quarantined"
      ]
    },
    "newState": {
      "type": "string",
      "enum": [
        "ready",
        "quarantined",
        "unknown",
        "cooldown"
      ]
    },
    "priorFenceEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "newFenceEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "PROFILE_RECLAIM_UNSAFE",
        "PROFILE_OUTWARD_EFFECT_INDETERMINATE",
        "RECOVERY_PRECONDITION_FAILED",
        "RECOVERY_LIVENESS_UNKNOWN",
        "RECOVERY_DEPENDENT_GRANT_REVOKE_FAILED",
        "RECOVERY_QUARANTINE_TIMEOUT",
        "RECOVERY_OPERATOR_RECONCILE",
        "RECOVERY_HOST_RESTART",
        "RECOVERY_EXTERNAL_USE_CLEARED"
      ]
    },
    "probeOutcomes": {
      "type": "object",
      "properties": {
        "governorHealth": {
          "type": "string",
          "enum": [
            "healthy",
            "unknown",
            "failed"
          ]
        },
        "runnerClaim": {
          "type": "string",
          "enum": [
            "active",
            "terminal",
            "revoked",
            "unknown"
          ]
        },
        "browserAlive": {
          "type": "boolean"
        },
        "extensionConnected": {
          "type": "boolean"
        },
        "dependentGrantsRevoked": {
          "type": "boolean"
        },
        "registryCurrent": {
          "type": "boolean"
        }
      },
      "required": [
        "governorHealth",
        "runnerClaim",
        "browserAlive",
        "extensionConnected"
      ],
      "additionalProperties": false
    },
    "lastActionOutcome": {
      "type": "string",
      "enum": [
        "none",
        "confirmed",
        "failed-known",
        "indeterminate",
        "blocked-before-action"
      ]
    },
    "dependentGrantRevokeStatus": {
      "type": "string",
      "enum": [
        "none",
        "revoked",
        "pending",
        "failed"
      ]
    },
    "authorityKind": {
      "type": "string",
      "enum": [
        "governor-automatic",
        "operator-approved"
      ],
      "description": "Governor is owner per D6 provisional; authority kind distinguishes automatic vs operator digest."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest over redacted receipt fields (JCS with domain label webmcp-digest-v1:terminal and LF framing)."
    },
    "eventId": {
      "type": "string",
      "pattern": "^pse_[0-9a-f]{16}$"
    }
  },
  "additionalProperties": false
}
